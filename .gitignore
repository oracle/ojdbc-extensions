# Miscellaneous
**/.DS_Store

# Maven
**/target/

# IntelliJ
*.iml
.idea
out/

# Eclipse
.project
.settings
.classpath

# Assume properties files may contain security sensitive information,
# such as a password. The first expression below excludes them all.
# The second expression overrides the first one to allow example properties
# files. Example files follow a naming convention; They have a prefix of:
# "example-"
**/*.properties
!**/example-*.properties

# Vim
**/*.swp
**/*.swo

# Assume environment variables may contain security sensitive information.
# Ignore any file not maked as an example.
**/*.env
!**/*.example.env

**/*.class